from pathlib import Path
from datetime import datetime
from typing import Optional
import sqlite3
import uuid

from fastapi import FastAPI, File, UploadFile, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from fastapi.staticfiles import StaticFiles
from pydantic import BaseModel
from PIL import Image
from ultralytics import YOLO


# --------------------------------------------------
# PATHS
# --------------------------------------------------

BASE_DIR = Path(__file__).resolve().parent
MODEL_PATH = BASE_DIR / "models" / "best.pt"
UPLOAD_DIR = BASE_DIR / "uploads"
DB_PATH = BASE_DIR / "civicvision.db"

UPLOAD_DIR.mkdir(parents=True, exist_ok=True)


# --------------------------------------------------
# APP
# --------------------------------------------------

app = FastAPI(
    title="CivicVision AI API",
    description="AI-powered civic issue reporting and prioritization backend.",
    version="1.0.0",
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=[
        "http://localhost:3000",
        "http://127.0.0.1:3000",
    ],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Makes saved complaint images available to the frontend.
app.mount(
    "/uploads",
    StaticFiles(directory=str(UPLOAD_DIR)),
    name="uploads",
)


# --------------------------------------------------
# MODEL
# --------------------------------------------------

if not MODEL_PATH.exists():
    raise FileNotFoundError(
        f"YOLO model not found: {MODEL_PATH}"
    )

model = YOLO(str(MODEL_PATH))


# --------------------------------------------------
# CONFIGURATION
# --------------------------------------------------

DEPARTMENTS = {
    "pothole": "Roads & Public Works",
    "garbage": "Sanitation / Solid Waste",
}

ALLOWED_STATUSES = {
    "Draft",
    "Submitted",
    "Under Review",
    "Assigned",
    "In Progress",
    "Resolved",
    "Closed",
}


# --------------------------------------------------
# DATABASE
# --------------------------------------------------

def get_connection():
    connection = sqlite3.connect(DB_PATH)
    connection.row_factory = sqlite3.Row
    return connection


def init_db():
    connection = get_connection()
    cursor = connection.cursor()

    cursor.execute(
        """
        CREATE TABLE IF NOT EXISTS reports (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            report_id TEXT UNIQUE NOT NULL,
            image_id TEXT NOT NULL,
            image_path TEXT NOT NULL,
            issue TEXT NOT NULL,
            confidence REAL NOT NULL,
            severity TEXT NOT NULL,
            priority TEXT NOT NULL,
            department TEXT NOT NULL,
            latitude REAL,
            longitude REAL,
            description TEXT,
            status TEXT NOT NULL DEFAULT 'Draft',
            created_at TEXT NOT NULL
        )
        """
    )

    connection.commit()
    connection.close()


init_db()


# --------------------------------------------------
# REQUEST MODELS
# --------------------------------------------------

class ComplaintSubmission(BaseModel):
    latitude: Optional[float] = None
    longitude: Optional[float] = None
    description: Optional[str] = None


class StatusUpdate(BaseModel):
    status: str


# --------------------------------------------------
# HELPERS
# --------------------------------------------------

def create_report_id() -> str:
    return f"CV-{uuid.uuid4().hex[:6].upper()}"


def create_image_id() -> str:
    return f"IMG-{uuid.uuid4().hex[:8].upper()}"


def severity_from_detection(
    area_ratio: float,
    confidence: float,
) -> str:
    if area_ratio >= 0.25 and confidence >= 0.80:
        return "critical"

    if area_ratio >= 0.12 and confidence >= 0.70:
        return "high"

    if area_ratio >= 0.04 or confidence >= 0.60:
        return "medium"

    return "low"


def row_to_dict(row: sqlite3.Row) -> dict:
    return {
        "id": row["id"],
        "report_id": row["report_id"],
        "image_id": row["image_id"],
        "image_path": row["image_path"],
        "issue": row["issue"],
        "confidence": row["confidence"],
        "severity": row["severity"],
        "priority": row["priority"],
        "department": row["department"],
        "latitude": row["latitude"],
        "longitude": row["longitude"],
        "description": row["description"],
        "status": row["status"],
        "created_at": row["created_at"],
    }


# --------------------------------------------------
# BASIC ROUTES
# --------------------------------------------------

@app.get("/")
async def root():
    return {
        "success": True,
        "message": "CivicVision AI backend is running.",
        "docs": "/docs",
    }


@app.get("/health")
async def health():
    return {
        "success": True,
        "model_loaded": MODEL_PATH.exists(),
        "database": DB_PATH.exists(),
    }


# --------------------------------------------------
# AI PREDICTION
# --------------------------------------------------

@app.post("/predict")
async def predict(image: UploadFile = File(...)):
    if not image.content_type or not image.content_type.startswith(
        "image/"
    ):
        raise HTTPException(
            status_code=400,
            detail="Please upload an image file.",
        )

    image_id = create_image_id()
    report_id = create_report_id()

    extension = Path(image.filename or "").suffix.lower()

    if extension not in {
        ".jpg",
        ".jpeg",
        ".png",
        ".webp",
        ".bmp",
    }:
        extension = ".webp"

    image_path = UPLOAD_DIR / f"{image_id}{extension}"

    image_bytes = await image.read()

    if not image_bytes:
        raise HTTPException(
            status_code=400,
            detail="The uploaded image is empty.",
        )

    try:
        image_path.write_bytes(image_bytes)
        pil_image = Image.open(image_path).convert("RGB")
    except Exception as exc:
        if image_path.exists():
            image_path.unlink()

        raise HTTPException(
            status_code=400,
            detail=f"Invalid image file: {exc}",
        )

    try:
        results = model.predict(
            source=pil_image,
            conf=0.25,
            verbose=False,
        )
    except Exception as exc:
        if image_path.exists():
            image_path.unlink()

        raise HTTPException(
            status_code=500,
            detail=f"YOLO prediction failed: {exc}",
        )

    result = results[0]

    detections = []

    image_width, image_height = pil_image.size
    total_pixels = max(image_width * image_height, 1)

    if result.boxes is not None:
        for box in result.boxes:
            cls_index = int(box.cls[0].item())
            confidence = float(box.conf[0].item())

            if isinstance(model.names, dict):
                raw_issue = model.names.get(
                    cls_index,
                    str(cls_index),
                )
            else:
                raw_issue = model.names[cls_index]

            issue = str(raw_issue).lower().strip()

            coordinates = box.xyxy[0].tolist()

            x1, y1, x2, y2 = coordinates

            box_width = max(0.0, x2 - x1)
            box_height = max(0.0, y2 - y1)

            area_ratio = (
                box_width * box_height
            ) / total_pixels

            severity = severity_from_detection(
                area_ratio,
                confidence,
            )

            priority = severity

            department = DEPARTMENTS.get(
                issue,
                "Municipal General Services",
            )

            detections.append(
                {
                    "issue": issue,
                    "confidence": round(
                        confidence,
                        4,
                    ),
                    "severity": severity,
                    "priority": priority,
                    "department": department,
                    "box": [
                        round(float(value), 2)
                        for value in coordinates
                    ],
                }
            )

    if not detections:
        if image_path.exists():
            image_path.unlink()

        raise HTTPException(
            status_code=422,
            detail="No supported civic issue was detected in the image.",
        )

    # Use the highest-confidence detection as the main report result.
    primary = max(
        detections,
        key=lambda item: item["confidence"],
    )

    created_at = datetime.now().isoformat()

    # IMPORTANT:
    # /predict creates a DRAFT, not a submitted complaint.
    # The complaint becomes visible in /reports only after
    # /reports/{report_id}/submit is called.
    connection = get_connection()
    cursor = connection.cursor()

    cursor.execute(
        """
        INSERT INTO reports (
            report_id,
            image_id,
            image_path,
            issue,
            confidence,
            severity,
            priority,
            department,
            latitude,
            longitude,
            description,
            status,
            created_at
        )
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """,
        (
            report_id,
            image_id,
            str(image_path),
            primary["issue"],
            primary["confidence"],
            primary["severity"],
            primary["priority"],
            primary["department"],
            None,
            None,
            None,
            "Draft",
            created_at,
        ),
    )

    connection.commit()
    connection.close()

    return {
        "success": True,
        "report_id": report_id,
        "image_id": image_id,
        "issue": primary["issue"],
        "confidence": primary["confidence"],
        "severity": primary["severity"],
        "priority": primary["priority"],
        "department": primary["department"],
        "status": "Draft",
        "created_at": created_at,
        "detections": detections,
    }


# --------------------------------------------------
# SUBMIT COMPLAINT
# --------------------------------------------------

@app.post("/reports/{report_id}/submit")
async def submit_report(
    report_id: str,
    submission: ComplaintSubmission,
):
    connection = get_connection()
    cursor = connection.cursor()

    cursor.execute(
        """
        SELECT *
        FROM reports
        WHERE report_id = ?
        """,
        (report_id,),
    )

    row = cursor.fetchone()

    if row is None:
        connection.close()

        raise HTTPException(
            status_code=404,
            detail="Report not found.",
        )

    latitude = submission.latitude
    longitude = submission.longitude
    description = (
        submission.description.strip()
        if submission.description
        else None
    )

    cursor.execute(
        """
        UPDATE reports
        SET latitude = ?,
            longitude = ?,
            description = ?,
            status = ?
        WHERE report_id = ?
        """,
        (
            latitude,
            longitude,
            description,
            "Submitted",
            report_id,
        ),
    )

    connection.commit()

    cursor.execute(
        """
        SELECT *
        FROM reports
        WHERE report_id = ?
        """,
        (report_id,),
    )

    updated_row = cursor.fetchone()
    connection.close()

    return {
        "success": True,
        "report": row_to_dict(updated_row),
    }


# --------------------------------------------------
# GET REPORTS
# --------------------------------------------------

@app.get("/reports")
async def get_reports():
    connection = get_connection()
    cursor = connection.cursor()

    # Drafts are intentionally excluded.
    # Only finalized citizen complaints appear
    # in the officer dashboard, My Complaints,
    # analytics, and notifications.
    cursor.execute(
        """
        SELECT *
        FROM reports
        WHERE status != 'Draft'
        ORDER BY id DESC
        """
    )

    rows = cursor.fetchall()
    connection.close()

    return {
        "success": True,
        "reports": [
            row_to_dict(row)
            for row in rows
        ],
    }


# --------------------------------------------------
# GET SINGLE REPORT
# --------------------------------------------------

@app.get("/reports/{report_id}")
async def get_report(report_id: str):
    connection = get_connection()
    cursor = connection.cursor()

    cursor.execute(
        """
        SELECT *
        FROM reports
        WHERE report_id = ?
        """,
        (report_id,),
    )

    row = cursor.fetchone()
    connection.close()

    if row is None:
        raise HTTPException(
            status_code=404,
            detail="Report not found.",
        )

    return {
        "success": True,
        "report": row_to_dict(row),
    }


# --------------------------------------------------
# UPDATE STATUS
# --------------------------------------------------

@app.patch("/reports/{report_id}/status")
async def update_report_status(
    report_id: str,
    update: StatusUpdate,
):
    if update.status not in ALLOWED_STATUSES:
        raise HTTPException(
            status_code=400,
            detail="Invalid status.",
        )

    if update.status == "Draft":
        raise HTTPException(
            status_code=400,
            detail="Draft is managed automatically by the submission workflow.",
        )

    connection = get_connection()
    cursor = connection.cursor()

    cursor.execute(
        """
        UPDATE reports
        SET status = ?
        WHERE report_id = ?
        AND status != 'Draft'
        """,
        (
            update.status,
            report_id,
        ),
    )

    if cursor.rowcount == 0:
        connection.close()

        raise HTTPException(
            status_code=404,
            detail="Submitted report not found.",
        )

    connection.commit()

    cursor.execute(
        """
        SELECT *
        FROM reports
        WHERE report_id = ?
        """,
        (report_id,),
    )

    row = cursor.fetchone()
    connection.close()

    return {
        "success": True,
        "report": row_to_dict(row),
    }
